{
  "name": "campus-wall",
  "version": "1.0.0",
  "description": "校园墙 - 匿名校园社交墙",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "install:all": "npm install --prefix server && npm install --prefix client",
    "build": "npm install --prefix client && npm run build --prefix client",
    "build:fn": "esbuild netlify/functions-src/api.js --bundle --platform=node --target=node20 --format=cjs --outfile=netlify/functions/api.js --alias:pg-native=./netlify/stubs/pg-native.js --alias:supports-color=./netlify/stubs/supports-color.js",
    "start": "node server/index.js",
    "dev": "node server/index.js"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "serverless-http": "^3.2.0",
    "wrangler": "^4.156.0"
  }
}
