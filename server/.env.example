# ===== 校园墙环境变量配置模板 =====
# 复制本文件为 .env 并填入你的值，切勿将真实密钥提交到代码仓库

# 服务端口
PORT=3000

# PostgreSQL 连接串（必填，缺失时服务会直接退出，不会回退到本地 SQLite）
# 获取位置：Supabase → Project Settings → Database → Connection string（URI 形式）
# 例如：postgresql://postgres.xxxx:密码@aws-0-xx.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=
# 连接池最大连接数（可选，默认 10）
PG_POOL_MAX=

# 上传文件目录（云平台挂载磁盘时可指定，如 /var/data/uploads）
UPLOADS_DIR=

# JWT 密钥（请替换为随机长字符串）
JWT_SECRET=please-change-this-to-a-long-random-string

# 管理员密码（后台 /admin 登录用）
ADMIN_PASSWORD=admin123

# 超级管理员密码（安全告警、封禁、强制删除、查看私信等）
SUPER_ADMIN_PASSWORD=super123456

# ===== Supabase Storage 对象存储（推荐，免费 1GB，仅邮箱注册）=====
# 注册：https://supabase.com
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=

# ===== Cloudflare R2 对象存储（免费 10GB，但需绑定银行卡）=====
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# ===== 七牛云对象存储（可选）=====
QINIU_ACCESS_KEY=
QINIU_SECRET_KEY=
QINIU_BUCKET=
QINIU_DOMAIN=

# ===== 阿里云短信（手机注册验证，可选）=====
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=
