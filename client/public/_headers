# Cloudflare Pages 缓存策略
# 入口 HTML 每次都校验，确保 WebView / 浏览器拿到最新版本
/index.html
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

/*
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

# 带 hash 的静态资源（JS/CSS/图片）长期缓存，文件名 hash 变了自然失效
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# API 绝对不缓存
/api/*
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0
  Pragma: no-cache
  Expires: 0

/uploads/*
  Cache-Control: public, max-age=31536000, immutable
